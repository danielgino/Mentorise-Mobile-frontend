# Backend API base URL
# iOS Simulator / web: http://localhost:8080
# Android Emulator:    http://10.0.2.2:8080
# Physical device:     http://<your-machine-LAN-IP>:8080
# Production:          https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:8080

# Cloudinary unsigned upload configuration
# These are not API secrets — they identify your unsigned upload preset.
# Find them in your Cloudinary dashboard under Settings > Upload Presets.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
